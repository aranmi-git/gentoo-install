# gentoo-install preset v1
# name: kde-openrc
# id: kde-openrc@024bca8632ae482d
# Made by gentoo-install.sh 1.0 on 2026-11-18.
# Load it with:  bash gentoo-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
INIT=openrc
BUILD=bin
CPU_JOBS=auto
EMERGE_JOBS=auto
CPU_MARCH=generic
KERNEL=bin
GURU=0
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SECUREBOOT=0
SNAPPER=1
SWAP=zram
SWAP_SIZE=4
MIRROR=auto
HOST_NAME=gentoo
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=plasma
DM=sddm
DOTS=
GPU=auto
APPS=firefox vlc libreoffice flatpak git
GAMING=
PERIPH=
EXTRA_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
